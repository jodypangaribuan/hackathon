# ============================================================================
# SIPATURE — environment configuration (template)
# ----------------------------------------------------------------------------
# Salin file ini ke `.env` lalu isi nilai nyata:
#   cp .env.example .env
# JANGAN commit `.env` ke git (berisi credentials).
# ============================================================================

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=sipature
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=sipature
# Port host yang dipetakan ke 5432 di dalam container.
POSTGRES_PORT=5432

# --- Web (Next.js) ----------------------------------------------------------
# Port host yang dipetakan ke 3000 di dalam container.
WEB_PORT=3000

# --- Inference (FastAPI) ----------------------------------------------------
# Port host yang dipetakan ke 8000 di dalam container.
INFERENCE_PORT=8000

# --- Model TF-IDF (dipakai service inference) -------------------------------
# Path model di dalam container inference (biasanya tidak perlu diubah).
INFERENCE_MODEL_DIR=/app/model
