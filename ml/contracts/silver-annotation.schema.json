{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sipature.local/schemas/silver-annotation.schema.json",
  "title": "SIPATURE AI-assisted silver annotation",
  "type": "object",
  "required": [
    "review_id", "destination_id", "text", "labels", "annotation_version",
    "label_source", "silver_status", "pass_agreement"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "destination_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "rating_context": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["aspect", "polarity", "severity", "evidence_text", "vote_count", "confidence"],
        "properties": {
          "aspect": {"type": "string"},
          "polarity": {"enum": ["positive", "negative", "neutral"]},
          "severity": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
          "evidence_text": {"type": "string", "minLength": 1},
          "vote_count": {"type": "integer", "minimum": 2, "maximum": 3},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "annotation_version": {"const": "silver-1.0.0"},
    "label_source": {"const": "ai_assisted_weak_supervision"},
    "silver_status": {"enum": ["consensus", "review_recommended", "no_supported_aspect"]},
    "pass_agreement": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
