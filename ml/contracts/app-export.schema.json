{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sipature.local/schemas/app-export.schema.json",
  "title": "SIPATURE application export",
  "type": "object",
  "required": ["schema_version", "model_version", "generated_at", "destinations"],
  "properties": {
    "schema_version": { "type": "string" },
    "model_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_manifest": { "type": "string" },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["destination_id", "name", "data_confidence", "priority", "issues"],
        "properties": {
          "destination_id": { "type": "string" },
          "name": { "type": "string" },
          "data_confidence": { "enum": ["high", "medium", "low", "insufficient"] },
          "priority": { "enum": ["Critical", "High", "Medium", "Monitor", "Insufficient Data"] },
          "issues": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
